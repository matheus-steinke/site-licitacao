# Copie para .env.local e preencha. Nunca coloque valores reais neste arquivo.

# Supabase: Project Settings > API (URL do projeto e chave "publishable").
# Estas duas são públicas por natureza (vão para o navegador); a segurança vem do RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Opcional: endereço público do app, usado nos links dos e-mails de confirmação.
# Em branco, o app usa o endereço da própria requisição.
NEXT_PUBLIC_SITE_URL=

# Integração com o Google (Agenda e Drive): cliente OAuth criado no Google Cloud Console.
# Veja o README, seção Integrações. A chave secreta é segredo: na Vercel, cadastre em
# Settings > Environment Variables; no GitHub Actions, como Secret. Nunca em NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Coletor do PNCP (só para rodar "pnpm coletor" na sua máquina; no GitHub Actions estes
# valores vêm de Settings > Secrets and variables). A chave de serviço ignora o RLS:
# nunca a coloque na Vercel nem em variável NEXT_PUBLIC_.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
